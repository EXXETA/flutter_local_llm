# Copy this file to .env and fill in your values.
# Only sample.env is tracked in git — .env is gitignored.
#
# Get your token at https://huggingface.co/settings/tokens
# Required for gated models (Gemma 3, EmbeddingGemma).
# Public models (Qwen3, SmolLM, DeepSeek, Phi-4) work without a token.
HUGGING_FACE_API_KEY=
